# GoHighLevel — Private Integration inside your Lindsey sub-account (all scopes)
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_NURTURE_WORKFLOW_ID=

# Default: poll Lindsey sub-account for trigger tags. Set to "webhook" only if using /ghl/trigger.
TRIGGER_MODE=poll
GHL_INBOUND_WEBHOOK_SECRET=

# Lindsey voice examples (from lindsey-ai / Claude persona project)
LINDSEY_VOICE_EXAMPLES_PATH=/Users/lindseyconrad/Downloads/lindsey-ai/data/voice_examples.jsonl

# Vapi — https://dashboard.vapi.ai
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
# Voice: 11labs + Laura (default). Paste your ElevenLabs voice-clone ID into VAPI_VOICE_ID for best realism.
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_ID=FGY2WhTYpPnrIDTdsKH5
VAPI_ELEVENLABS_MODEL=eleven_turbo_v2_5
# Lower stability + higher style = warmer, less monotone delivery
VAPI_ELEVENLABS_STABILITY=0.42
VAPI_ELEVENLABS_SIMILARITY=0.78
VAPI_ELEVENLABS_STYLE=0.42
VAPI_ELEVENLABS_SPEED=0.97
VAPI_ELEVENLABS_USE_SPEAKER_BOOST=true
VAPI_MAX_CALL_DURATION_SECONDS=180
# Outbound cost controls (Vapi default silence timeout is 30s)
VAPI_SILENCE_TIMEOUT_SECONDS=12
VAPI_VOICEMAIL_DETECTION_ENABLED=true
VAPI_VOICEMAIL_BEEP_MAX_AWAIT_SECONDS=15
# VAPI_VOICEMAIL_MESSAGE=Hi, it's Lindsey's team at Conrad Mortgage...
# Outbound pacing (assistant speaks first on dial-out)
VAPI_RESPONSE_DELAY_SECONDS=0.25
VAPI_START_WAIT_SECONDS=0.45
# Inbound callbacks — separate assistant on the phone number (run create_assistant.py to sync)
VAPI_INBOUND_ASSISTANT_ID=
VAPI_INBOUND_BOT_NAME=Alex
VAPI_INBOUND_START_WAIT_SECONDS=0.45
VAPI_INBOUND_RESPONSE_DELAY_SECONDS=0.08
VAPI_INBOUND_LLM_REQUEST_DELAY_SECONDS=0
VAPI_INBOUND_TRANSCRIBER_ENDPOINTING=100
VAPI_INBOUND_FIRST_MESSAGE=Hey, hello?

# Twilio import into Vapi (optional in .env — or pass to connect_twilio.py)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WEBHOOK_BASE_URL=https://your-server.example.com

# Google Calendar
GCAL_CALENDAR_ID=lindsey@example.com
GCAL_CREDENTIALS_PATH=credentials/service_account.json
GCAL_TIMEZONE=America/New_York
GCAL_SLOT_DURATION_MINUTES=30
GCAL_BOOKING_HORIZON_DAYS=14

# Orchestrator pacing
MAX_CONCURRENT_CALLS=2
POLL_INTERVAL_SECONDS=300
MAX_ATTEMPTS_PER_LEAD=3
MIN_HOURS_BETWEEN_ATTEMPTS=24

# SQLite
DATABASE_PATH=data/caller.db

# Daily summary email (8 PM)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUMMARY_EMAIL_TO=lindsey@example.com

# Business context for calendar event descriptions
BUSINESS_NAME=Conrad Mortgage
